# Copy to .env.local and fill in. .env*.local is gitignored — never commit real values.

# ── Résumé gate ──────────────────────────────────────────────────────────────
RESUME_PASSWORD=
BLOB_READ_WRITE_TOKEN=

# ── Site view counter (Upstash Redis) ────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Spotify "now playing" ────────────────────────────────────────────────────
# Optional. Without all three the homepage falls back to the hardcoded rotation
# in src/components/home/tracks.ts, which is a supported state, not a failure.
#
# One-time setup:
#   1. https://developer.spotify.com/dashboard -> your app -> Basic Information
#   2. Copy the Client ID and Client secret into the two lines below.
#   3. Register BOTH redirect URIs on the Spotify app, exactly:
#        http://127.0.0.1:3000/api/spotify/callback
#        https://<your-production-domain>/api/spotify/callback
#      Spotify rejects "localhost" for new apps; the loopback IP is required.
#   4. Restart the dev server, open http://127.0.0.1:3000/api/spotify/login
#      and approve. The callback prints a refresh token as plain text.
#   5. Paste it into SPOTIFY_REFRESH_TOKEN below and restart again.
#   6. Add all three to the Vercel project's environment variables.
#
# The refresh token does not expire on its own, but ROTATING THE CLIENT SECRET
# invalidates it — after a rotation, run step 4 again.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
